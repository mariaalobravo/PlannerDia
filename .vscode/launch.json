{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": { "BACKEND_PORT": "5050" }
    },
    {
      "name": "Frontend (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/server.js",
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "env": { "PORT": "3000", "BACKEND_URL": "http://127.0.0.1:5050" },
      "serverReadyAction": {
        "pattern": "listo en\\s+→\\s+(http://localhost:\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "▶ Mi Día (todo)",
      "configurations": ["Backend (Python)", "Frontend (Node)"],
      "stopAll": true
    }
  ]
}
